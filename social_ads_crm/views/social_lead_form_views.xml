<odoo>
  <record id="view_social_lead_form_tree" model="ir.ui.view"><field name="name">social.lead.form.tree</field><field name="model">social.lead.form</field><field name="arch" type="xml"><tree><field name="provider"/><field name="name"/><field name="ad_account_id"/><field name="team_id"/><field name="import_mode"/><field name="webhook_status"/><field name="last_lead_time"/></tree></field></record>
  <record id="view_social_lead_form_form" model="ir.ui.view"><field name="name">social.lead.form.form</field><field name="model">social.lead.form</field><field name="arch" type="xml">
    <form><header><button name="action_register_webhook" string="Register Snapchat Webhook" type="object" class="oe_highlight" invisible="provider != 'snapchat' or webhook_status == 'active'"/><button name="action_send_test_lead" string="Send Test Lead" type="object" invisible="provider != 'snapchat' or webhook_status != 'active'"/><button name="action_delete_webhook" string="Remove Webhook" type="object" invisible="provider != 'snapchat' or webhook_status != 'active'"/></header>
    <sheet><group><group><field name="provider" readonly="1"/><field name="name"/><field name="external_form_id" readonly="1"/><field name="connection_id"/><field name="ad_account_id"/></group><group><field name="status"/><field name="import_mode"/><field name="team_id"/><field name="stage_id" invisible="import_mode != 'opportunity'"/><field name="tag_ids" widget="many2many_tags"/></group></group>
    <group string="Webhook"><field name="webhook_status" readonly="1"/><field name="webhook_integration_id" readonly="1"/><field name="webhook_url" readonly="1"/><field name="last_error" readonly="1"/></group>
    <notebook><page string="Field Mapping"><group><field name="auto_mapping_enabled"/><field name="unmapped_field_policy"/></group><field name="mapping_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="external_key"/><field name="external_label"/><field name="aliases"/><field name="odoo_field_name"/><field name="active"/></tree></field></page>
    <page string="Notifications"><group><field name="notify_on_new_lead"/><field name="notification_user_ids" widget="many2many_tags"/><field name="notify_assigned_salesperson"/><field name="create_notification_activity"/></group></page>
    <page string="Raw Questions"><field name="questions_json" readonly="1"/></page></notebook></sheet><chatter/></form>
  </field></record>
  <record id="action_social_lead_form" model="ir.actions.act_window"><field name="name">Lead Forms</field><field name="res_model">social.lead.form</field><field name="view_mode">tree,form</field></record>
</odoo>
