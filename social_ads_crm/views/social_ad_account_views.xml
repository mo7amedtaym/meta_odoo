<odoo>
  <record id="view_social_ad_account_tree" model="ir.ui.view"><field name="name">social.ads.account.tree</field><field name="model">social.ads.account</field><field name="arch" type="xml"><tree><field name="provider"/><field name="name"/><field name="external_id"/><field name="status"/><field name="currency"/><button name="action_sync_forms" string="Sync Forms" type="object"/></tree></field></record>
