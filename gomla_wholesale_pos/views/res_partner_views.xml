<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_gomla" model="ir.ui.view">
        <field name="name">res.partner.form.gomla</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Wholesale Agreement" name="gomla_wholesale_agreement">
                    <group>
                        <group>
                            <field name="gomla_is_supplier"/>
                            <field name="gomla_default_commission_percent" invisible="not gomla_is_supplier"/>
                            <field name="gomla_uses_crates" invisible="not gomla_is_supplier"/>
                        </group>
                        <group invisible="not gomla_is_supplier">
                            <field name="gomla_supplier_balance" readonly="1"/>
                            <field name="gomla_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="gomla_agreement_notes" invisible="not gomla_is_supplier" placeholder="Commission, freight and settlement terms..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
