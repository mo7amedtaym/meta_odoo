<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gomla_shipment_list" model="ir.ui.view">
        <field name="name">gomla.shipment.list</field>
        <field name="model">gomla.shipment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-warning="state in ('nearly_finished', 'pending_settlement')" decoration-muted="state == 'settled'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="arrival_date"/>
                <field name="state" widget="badge"/>
                <field name="received_qty" sum="Total"/>
                <field name="sold_qty" sum="Total"/>
                <field name="remaining_qty" sum="Total"/>
                <field name="gross_sales_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_gomla_shipment_search" model="ir.ui.view">
        <field name="name">gomla.shipment.search</field>
        <field name="model">gomla.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="nearly" string="Nearly Finished" domain="[('state', '=', 'nearly_finished')]"/>
                <filter name="pending" string="Pending Settlement" domain="[('state', '=', 'pending_settlement')]"/>
                <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <group expand="0" string="Group By">
                    <filter name="supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gomla_shipment_form" model="ir.ui.view">
        <field name="name">gomla.shipment.form</field>
        <field name="model">gomla.shipment</field>
        <field name="arch" type="xml">
            <form string="Wholesale Shipment">
                <header>
                    <button name="action_settle" type="object" string="Approve and Close Settlement" class="oe_highlight" invisible="state != 'pending_settlement'" groups="gomla_wholesale_pos.group_gomla_manager" confirm="This will create an immutable supplier settlement. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,nearly_finished,stock_finished,pending_settlement,settled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Settled" bg_color="text-bg-success" invisible="state != 'settled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id" readonly="state == 'settled'"/>
                            <field name="arrival_date" readonly="state == 'settled'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'settled'"/>
                        </group>
                        <group>
                            <field name="supplier_commission_percent" readonly="state == 'settled'"/>
                            <field name="freight_amount" readonly="state == 'settled'"/>
                            <field name="aqlamiya_amount" readonly="state == 'settled'"/>
                            <field name="stock_finished_at" readonly="1" invisible="not stock_finished_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Produce" name="produce">
                            <field name="line_ids" readonly="state in ('pending_settlement', 'settled')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="received_qty"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="sold_qty" readonly="1"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="gross_sales_amount" readonly="1"/>
                                    <field name="crate_qty_received"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Financial Summary" name="financial">
                            <group>
                                <group>
                                    <field name="gross_sales_amount"/>
                                    <field name="seller_commission_amount" help="Displayed separately and excluded from supplier settlement."/>
                                    <field name="supplier_commission_percent"/>
                                </group>
                                <group>
                                    <field name="freight_amount"/>
                                    <field name="aqlamiya_amount"/>
                                    <field name="supplier_net_preview" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                            <field name="settlement_id" readonly="1">
                                <list>
                                    <field name="settled_at"/>
                                    <field name="settled_by"/>
                                    <field name="gross_sales_amount"/>
                                    <field name="supplier_commission_amount"/>
                                    <field name="freight_amount"/>
                                    <field name="aqlamiya_amount"/>
                                    <field name="supplier_net_amount"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Receiving and agreement notes..." readonly="state == 'settled'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gomla_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">gomla.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gomla_shipment_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="view_gomla_supplier_ledger_list" model="ir.ui.view">
        <field name="name">gomla.supplier.ledger.list</field>
        <field name="model">gomla.supplier.ledger</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="date"/>
                <field name="supplier_id"/>
                <field name="description"/>
                <field name="shipment_id"/>
                <field name="amount" sum="Balance"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_gomla_supplier_ledger" model="ir.actions.act_window">
        <field name="name">Supplier Ledger</field>
        <field name="res_model">gomla.supplier.ledger</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

