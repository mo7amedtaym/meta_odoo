<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form" name="Tap Payments Redirect Form">
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params or {}" t-as="key">
                <input type="hidden" t-att-name="key" t-att-value="url_params[key]"/>
            </t>
        </form>
    </template>
</odoo>
