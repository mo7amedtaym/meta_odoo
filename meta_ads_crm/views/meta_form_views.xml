<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lead Form List -->
    <record id="meta_lead_form_view_tree" model="ir.ui.view">
        <field name="name">meta.lead.form.list</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <list>
                <field name="form_id"/>
                <field name="name"/>
                <field name="page_id"/>
                <field name="status"/>
                <field name="import_mode"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="lead_count" string="Leads"/>
            </list>
        </field>
    </record>

    <!-- Lead Form Form -->
    <record id="meta_lead_form_view_form" model="ir.ui.view">
        <field name="name">meta.lead.form.form</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_from_meta" type="object"
                            string="Sync from Meta" class="btn btn-primary"
                            invisible="not page_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_meta_lead_log)d" type="action"
                                class="oe_stat_button" icon="fa-list">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Lead Form Name"/></h1>
                    </div>
                    <group>
                        <group string="Meta Info">
                            <field name="form_id"/>
                            <field name="page_id"/>
                            <field name="status"/>
                            <field name="locale"/>
                        </group>
                        <group string="CRM Settings">
                            <field name="import_mode"/>
                            <field name="team_id"/>
                            <field name="stage_id"
                                   invisible="import_mode != 'opportunity'"
                                   required="import_mode == 'opportunity'"
                                   domain="['|', ('team_id', '=', False), ('team_id', '=', team_id)]"/>
                            <field name="user_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Field Mappings" name="mappings">
                            <field name="field_mapping_ids">
                                <list editable="bottom">
                                    <field name="meta_key"/>
                                    <field name="meta_label"/>
                                    <field name="odoo_field_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="URLs" name="urls">
                            <group>
                                <field name="privacy_policy_url" widget="url"/>
                                <field name="thank_you_url" widget="url"/>
                                <field name="follow_up_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Lead Form Search -->
    <record id="meta_lead_form_view_search" model="ir.ui.view">
        <field name="name">meta.lead.form.search</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="form_id"/>
                <field name="page_id"/>
                <filter name="active_only" string="Active" domain="[('status','=','ACTIVE')]"/>
                <separator/>
                <filter name="group_by_page" string="Page" context="{'group_by':'page_id'}"/>
                <filter name="group_by_status" string="Status" context="{'group_by':'status'}"/>
                <filter name="group_by_import_mode" string="Import Mode" context="{'group_by':'import_mode'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_meta_lead_form" model="ir.actions.act_window">
        <field name="name">Lead Forms</field>
        <field name="res_model">meta.lead.form</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="meta_lead_form_view_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>
</odoo>
