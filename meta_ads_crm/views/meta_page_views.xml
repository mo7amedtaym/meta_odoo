<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pages List -->
    <record id="meta_page_view_tree" model="ir.ui.view">
        <field name="name">meta.page.list</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="page_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="ig_connected"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Pages Form -->
    <record id="meta_page_view_form" model="ir.ui.view">
        <field name="name">meta.page.form</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_subscribe_webhook" type="object"
                            string="Subscribe Webhook" class="btn btn-primary"/>
                    <button name="action_check_webhook_subscription" type="object"
                            string="Check Subscription" class="btn btn-secondary"/>
                    <button name="action_sync_forms" type="object"
                            string="Sync Lead Forms" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Page Name"/></h1>
                    </div>
                    <group>
                        <group string="Meta Info">
                            <field name="page_id"/>
                            <field name="category"/>
                            <field name="fb_user_id"/>
                        </group>
                        <group string="Status">
                            <field name="webhook_subscribed"/>
                            <field name="ig_connected"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lead Forms" name="forms">
                            <field name="lead_form_ids"/>
                        </page>
                        <page string="Instagram" name="instagram">
                            <field name="ig_account_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_meta_page" model="ir.actions.act_window">
        <field name="name">Pages</field>
        <field name="res_model">meta.page</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
