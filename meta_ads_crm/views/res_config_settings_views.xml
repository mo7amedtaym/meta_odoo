<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meta_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meta.ads</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Meta Ads Settings" class="oe_form_configuration" js_class="base_settings">
                <app data-string="Meta Ads" string="Meta Ads" name="meta_ads_crm"
                     groups="base.group_system">
                    <field name="meta_connected" invisible="1"/>
                    <block title="Connection">
                        <setting>
                            <div class="row">
                                <div class="col-lg-6">
                                    <label for="meta_app_id" class="o_light_label"/>
                                    <field name="meta_app_id" placeholder="e.g. 123456789"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="meta_app_secret" class="o_light_label"/>
                                    <field name="meta_app_secret" password="True" placeholder="App Secret"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="meta_webhook_verify_token" class="o_light_label"/>
                                    <field name="meta_webhook_verify_token" placeholder="Your verify token"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="meta_graph_version" class="o_light_label"/>
                                    <field name="meta_graph_version" placeholder="v26.0"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-12">
                                    <label for="meta_public_base_url" class="o_light_label"/>
                                    <field name="meta_public_base_url" placeholder="https://testmeta.o.cm.sa"/>
                                    <div class="text-muted">Use the public HTTPS URL only, without a trailing slash.</div>
                                    <div class="mt8">
                                        <field name="meta_request_pages_manage_metadata"/>
                                        <span class="text-muted ms-2">Keep this enabled when your Meta app accepts pages_manage_metadata. If Meta reports it as an Invalid Scope, disable this option and reconnect. You can enable it again later without updating the module.</span>
                                    </div>
                                    <div class="mt8">
                                        <label for="meta_effective_oauth_scopes" class="o_light_label"/>
                                        <field name="meta_effective_oauth_scopes" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Connection Health">
                        <setting string="Runtime Status">
                            <field name="meta_connection_status" readonly="1"/>
                            <div class="row mt8">
                                <div class="col-lg-6"><label for="meta_active_page_count"/><field name="meta_active_page_count" readonly="1"/></div>
                                <div class="col-lg-6"><label for="meta_token_expiry"/><field name="meta_token_expiry" readonly="1"/></div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6"><label for="meta_webhook_last_received_at"/><field name="meta_webhook_last_received_at" readonly="1"/></div>
                                <div class="col-lg-6"><label for="meta_webhook_last_lead_at"/><field name="meta_webhook_last_lead_at" readonly="1"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="OAuth &amp; Token">
                        <setting>
                            <div class="mt4 mb8">
                                <button name="action_connect_meta" type="object"
                                        class="btn btn-primary" string="Connect with Meta"
                                        invisible="meta_connected"/>
                                <button name="action_disconnect_meta" type="object"
                                        class="btn btn-danger" string="Disconnect"
                                        invisible="not meta_connected"/>
                            </div>
                            <div class="mt8">
                                <button name="action_generate_fernet_key" type="object"
                                        class="btn btn-secondary" string="Generate Encryption Key"/>
                            </div>
                        </setting>
                        <setting string="OAuth Diagnostics">
                            <label for="meta_oauth_last_status"/>
                            <field name="meta_oauth_last_status" readonly="1"/>
                            <label for="meta_oauth_last_error" invisible="not meta_oauth_last_error"/>
                            <field name="meta_oauth_last_error" readonly="1" invisible="not meta_oauth_last_error" nolabel="1"/>
                        </setting>
                    </block>
                    <block title="Missing Leads Recovery">
                        <setting string="Automatic Recovery">
                            <field name="meta_recovery_enabled"/>
                            <div class="mt8"><label for="meta_recovery_lookback_days"/><field name="meta_recovery_lookback_days"/></div>
                            <div class="mt8"><label for="meta_recovery_last_run_at"/><field name="meta_recovery_last_run_at" readonly="1"/></div>
                            <button name="action_run_meta_recovery_now" type="object" string="Recover Missing Leads Now" class="btn btn-primary mt8"/>
                            <div class="text-muted mt8">The cron periodically reads recent leads directly from Meta Forms and creates any leads that the webhook missed.</div>
                        </setting>
                    </block>
                    <block title="Webhook &amp; OAuth URLs">
                        <setting>
                            <div class="text-muted mb8">Use these exact URLs in Meta Developer Dashboard.</div>
                            <label for="meta_webhook_url" class="o_light_label"/>
                            <field name="meta_webhook_url" readonly="1"/>
                            <label for="meta_oauth_redirect_url" class="o_light_label mt8"/>
                            <field name="meta_oauth_redirect_url" readonly="1"/>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>

    <record id="meta_config_settings_action" model="ir.actions.act_window">
        <field name="name">Meta Ads Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="meta_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'meta_ads_crm', 'bin_size': False}</field>
    </record>
</odoo>
